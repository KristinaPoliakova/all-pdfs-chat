# Production template — DO NOT commit real secrets.
#
# On a server, copy to a path outside the repo, e.g.:
#   sudo cp backend/.env.production.example /etc/all-pdfs-chat/backend.env
#   sudo chmod 600 /etc/all-pdfs-chat/backend.env
# Then edit passwords and domain-specific values. This file is loaded via Docker
# Compose `env_file` — see docs/deployment.md.

APP_ENV=prod

# PostgreSQL (required)
# Host is the docker-compose service name "postgres". The password MUST match
# POSTGRES_PASSWORD in /opt/all-pdfs-chat/.env (used by the postgres service).
DATABASE_URL=postgresql+asyncpg://all_pdfs_chat:CHANGE_ME@postgres:5432/all_pdfs_chat

# PDF files on local disk (recommended for DigitalOcean VM)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/var/lib/all-pdfs-chat/uploads

# Max PDF upload size in bytes (default 10 MiB; max 100 MiB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Comma-separated origins for CORS (empty = disabled).
# Usually empty when nginx serves the app on one domain and proxies /api/v1 to the backend.
CORS_ALLOWED_ORIGINS=

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Page classification + parsing (worker; PyMuPDF + pdfplumber)
CLASSIFICATION_ENABLED=true
CLASSIFICATION_MAX_PAGES=10

# Background worker (run: uv run python -m app.worker)
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LOCK_TTL_SECONDS=300
WORKER_MAX_ATTEMPTS=3

# Parsing: simple pages = local PyMuPDF; complex pages = Azure DI when enabled
PARSING_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
PARSING_POLL_INTERVAL_SECONDS=2
PARSING_MAX_WAIT_SECONDS=600

# Auth session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# PDF Q&A agent (LangGraph). Chat-model provider: ollama | groq
#   groq -> hosted, fast, free tier — recommended for small prod VMs
LLM_PROVIDER=groq

# Groq (required when LLM_PROVIDER=groq). Get a key at https://console.groq.com
# Use a model with reliable tool calling; avoid llama-3.3-70b-versatile (it
# intermittently emits malformed tool calls Groq rejects with 400 tool_use_failed).
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_RETRIES=2

# Ollama (only when LLM_PROVIDER=ollama; needs a tool-calling model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

AGENT_SEARCH_TOP_K=4
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=60
AGENT_TOOL_CHAR_LIMIT=6000

# Agent tracing via MLflow (opt-in). The mlflow service is on the compose network.
# Tracing setup runs in the background and never blocks API startup. The app also
# defaults the MLflow REST client to fail-fast (no retries, 3s timeout); override
# MLFLOW_HTTP_REQUEST_MAX_RETRIES / MLFLOW_HTTP_REQUEST_TIMEOUT here if needed.
TRACING_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=all-pdfs-chat-agent

# HTTP request tracing (OpenTelemetry -> MLflow OTLP). Opt-in; use a low sample
# ratio in prod to limit overhead.
REQUEST_TRACING_ENABLED=true
REQUEST_TRACE_SAMPLE_RATIO=0.2
MLFLOW_HTTP_EXPERIMENT=all-pdfs-chat-http

# Rate limiting (prod only; disabled when APP_ENV=dev)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REGISTER=5/minute
RATE_LIMIT_AUTH_LOGIN=5/minute
RATE_LIMIT_AUTH_LOGOUT=30/minute
RATE_LIMIT_AUTH_ME=60/minute
RATE_LIMIT_PDF_UPLOAD=10/hour
RATE_LIMIT_PDF_READ=60/minute

# --- Optional Azure blob storage (not needed for DO local disk) ---
# STORAGE_BACKEND=azure
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=pdfs
