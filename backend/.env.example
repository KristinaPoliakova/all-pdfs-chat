# Application environment: dev | prod
# dev  -> LocalFileStorage + SQLite metadata (SqlPdfMetadataStore)
# prod -> Azure Blob + Azure SQL metadata (SqlPdfMetadataStore)
APP_ENV=dev

# SQLite metadata database (dev)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Azure SQL metadata database (prod)
# Example: mssql+aioodbc://user:pass@server.database.windows.net/db?driver=ODBC+Driver+18+for+SQL+Server
AZURE_SQL_DATABASE_URL=

# Max PDF upload size in bytes (default 10 MiB; max 100 MiB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Azure Blob Storage (prod — required when APP_ENV=prod)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=pdfs

# Comma-separated origins for CORS (empty = disabled)
CORS_ALLOWED_ORIGINS=

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Page classification on upload (PyMuPDF + pdfplumber)
CLASSIFICATION_ENABLED=true
CLASSIFICATION_MAX_PAGES=500
