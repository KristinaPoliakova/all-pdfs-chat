# Local development — copy to backend/.env (./scripts/dev.sh does this automatically)
# For production on a VM, use .env.production.example instead.

APP_ENV=dev

# SQLite database (documents, jobs, users, sessions)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Max PDF upload size in bytes (default 10 MiB; max 100 MiB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Comma-separated origins for CORS (empty = disabled).
# Usually empty locally — Next.js rewrites /api/v1 to the backend on the same origin.
CORS_ALLOWED_ORIGINS=

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Page classification + parsing (worker; PyMuPDF + pdfplumber)
CLASSIFICATION_ENABLED=true
CLASSIFICATION_MAX_PAGES=10

# Background worker (run: uv run python -m app.worker)
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LOCK_TTL_SECONDS=300
WORKER_MAX_ATTEMPTS=3

# Parsing: simple pages = local PyMuPDF; complex pages = Azure DI when enabled
PARSING_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
PARSING_POLL_INTERVAL_SECONDS=2
PARSING_MAX_WAIT_SECONDS=600

# Auth session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS=604800
