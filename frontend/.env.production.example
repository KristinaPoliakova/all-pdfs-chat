# Production template — DO NOT commit real secrets.
#
# On a server, copy to a path outside the repo, e.g.:
#   sudo cp frontend/.env.production.example /etc/all-pdfs-chat/frontend.env
#   sudo chmod 600 /etc/all-pdfs-chat/frontend.env
# Loaded via Docker Compose `env_file` for the frontend service — see docs/deployment.md.

# In Docker Compose, the frontend talks to the API over the internal network.
# (docker-compose.prod.yml also sets this; keep them consistent.)
BACKEND_URL=http://api:8000

# Browser fetch prefix — same origin when nginx serves one domain.
# Requests go to /api/v1/* on the public host; nginx or Next forwards to FastAPI.
NEXT_PUBLIC_API_BASE=/api/v1

# Client-side upload size cap in bytes (default 10 MiB; max 100 MiB).
# Must match backend MAX_UPLOAD_SIZE_BYTES.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760
